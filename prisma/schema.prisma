datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  phone       String?
  role        String   @default("CITIZEN") // CITIZEN, VOLUNTEER, SECURITY_STAFF, ADMIN
  department  String?
  badgeNumber String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Incident {
  id                   String              @id @default(uuid())
  incidentNumber       String              @unique
  title                String
  description          String
  category             String              // THEFT, CHAIN_SNATCHING, SUSPICIOUS_ACTIVITY, CROWD_ISSUE, MISSING_PERSON, PERSONAL_SAFETY, EMERGENCY, MEDICAL, FIRE, OTHER
  priority             String              @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status               String              @default("REPORTED") // REPORTED, VERIFIED, ASSIGNED, ACKNOWLEDGED, IN_PROGRESS, RESOLVED, CLOSED
  escalationLevel      String              @default("NORMAL") // NORMAL, WARNING, ESCALATED
  latitude             Float
  longitude            Float
  locationName         String
  reporterName         String?
  reporterPhone        String?
  isAnonymous          Boolean             @default(false)
  mediaUrl             String?
  
  // Duplication tracking
  masterIncidentId     String?
  duplicateScore       Float?
  
  // AI suggestions
  aiCategorySuggestion String?
  aiPrioritySuggestion String?
  aiTeamSuggestion     String?
  aiSummary            String?
  
  // Assignment
  assignedTeamId       String?
  assignedTeam         ResponseTeam?       @relation(fields: [assignedTeamId], references: [id])
  
  verifiedByAdmin      Boolean             @default(false)
  verifiedAt           DateTime?
  acknowledgedAt       DateTime?
  resolvedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  timelineEvents       CaseTimelineEvent[]
  reports              IncidentReport[]    @relation("MasterIncidentReports")
}

model IncidentReport {
  id               String    @id @default(uuid())
  masterIncidentId String
  masterIncident   Incident  @relation("MasterIncidentReports", fields: [masterIncidentId], references: [id], onDelete: Cascade)
  rawDescription   String
  locationName     String
  latitude         Float
  longitude        Float
  reporterContact  String?
  mediaUrl         String?
  similarityScore  Float     @default(0.9)
  createdAt        DateTime  @default(now())
}

model MissingPerson {
  id                   String              @id @default(uuid())
  caseNumber           String              @unique
  type                 String              @default("CHILD") // CHILD, ELDERLY, ADULT
  fullName             String
  age                  Int
  gender               String
  photoUrl             String?
  lastSeenLocation     String
  latitude             Float
  longitude            Float
  lastSeenTime         DateTime
  clothingDescription  String
  identifyingFeatures  String?
  medicalConditions    String?
  contactPersonName    String
  contactPhone         String
  contactRelation      String
  searchRadiusMeters   Int                 @default(1000)
  status               String              @default("REPORTED") // REPORTED, VERIFIED, SEARCH_DISPATCHED, SIGHTING_LOGGED, FOUND_SAFE, CLOSED
  isSensitive          Boolean             @default(true) // Child privacy protection
  assignedTeamId       String?
  assignedTeam         ResponseTeam?       @relation(fields: [assignedTeamId], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  sightings            Sighting[]
  timelineEvents       CaseTimelineEvent[]
}

model Sighting {
  id                 String        @id @default(uuid())
  missingPersonId    String
  missingPerson      MissingPerson @relation(fields: [missingPersonId], references: [id], onDelete: Cascade)
  reporterName       String
  reporterPhone      String?
  locationName       String
  latitude           Float
  longitude          Float
  sightingTime       DateTime      @default(now())
  photoUrl           String?
  description        String
  verificationStatus String        @default("PENDING") // PENDING, VERIFIED, FALSE_ALARM
  verifiedBy         String?
  createdAt          DateTime      @default(now())
}

model CrowdZone {
  id             String        @id @default(uuid())
  zoneCode       String        @unique
  name           String
  category       String        // ENTRY, EXIT, STAGE, PARKING, MEDICAL, HELP_DESK, RESTRICTED
  capacity       Int
  currentCount   Int
  densityRatio   Float         @default(0.0)
  riskLevel      String        @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  alertActive    Boolean       @default(false)
  alertMessage   String?
  latitude       Float
  longitude      Float
  radiusMeters   Int           @default(150)
  assignedTeamId String?
  assignedTeam   ResponseTeam? @relation(fields: [assignedTeamId], references: [id])
  lastUpdated    DateTime      @default(now())
}

model ResponseTeam {
  id                  String          @id @default(uuid())
  name                String
  type                String          // SECURITY, CROWD_CONTROL, SEARCH_RESCUE, MEDICAL, HELP_DESK
  leaderName          String
  contactRadio        String
  memberCount         Int             @default(4)
  status              String          @default("AVAILABLE") // AVAILABLE, DISPATCHED, ON_SCENE, OFF_DUTY
  currentLatitude     Float
  currentLongitude    Float
  currentLocationName String
  
  incidents           Incident[]
  missingPersons      MissingPerson[]
  crowdZones          CrowdZone[]
}

model SafeJourney {
  id                  String    @id @default(uuid())
  userId              String?
  userName            String    @default("Priya Sharma")
  startLocation       String
  destinationLocation String
  startLat            Float
  startLng            Float
  destLat             Float
  destLng             Float
  transportMode       String    @default("AUTO") // AUTO, CAB, WALKING, BUS
  status              String    @default("ACTIVE") // ACTIVE, DEVIATION_DETECTED, PANIC_TRIGGERED, COMPLETED, CANCELLED
  isSafe              Boolean   @default(true)
  deviationTriggered  Boolean   @default(false)
  deviationReason     String?
  lastKnownLat        Float
  lastKnownLng        Float
  trustedContactName  String    @default("Rahul Sharma")
  trustedContactPhone String    @default("+91 98765 43210")
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
}

model TrustedContact {
  id           String   @id @default(uuid())
  userId       String
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model AlertNotification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("INCIDENT") // INCIDENT, MISSING_PERSON, CROWD, SAFE_JOURNEY, SYSTEM
  priority  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  targetRole String  @default("ALL") // ALL, CITIZEN, VOLUNTEER, SECURITY_STAFF, ADMIN
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())
}

model CaseTimelineEvent {
  id              String         @id @default(uuid())
  incidentId      String?
  incident        Incident?      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  missingPersonId String?
  missingPerson   MissingPerson? @relation(fields: [missingPersonId], references: [id], onDelete: Cascade)
  eventType       String         // CREATED, AI_TRIAGED, VERIFIED, DISPATCHED, ACKNOWLEDGED, STATUS_UPDATE, RESOLVED, CLOSED
  description     String
  actorName       String
  actorRole       String
  createdAt       DateTime       @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  actorName    String
  actorRole    String
  targetEntity String
  targetId     String?
  details      String?
  createdAt    DateTime @default(now())
}
